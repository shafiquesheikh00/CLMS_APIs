  "rdateFrom": "2026-04-01T00:00:00Z",
  "rdateTo": "2027-03-31T00:00:00Z",
  "labourCatId": 1,
  "basic": 600.00,
  "specialAllowance": 50.00,
  "hra": 100.00,
  "otherAllowance": 25.00,
