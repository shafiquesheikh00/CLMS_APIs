  "bonusPer": 0,
  "bonus": 0,
  "lww": 0,
  "pfper": 0,
  "pf": 0,
  "attendanceAllowAppAfter": 0,
  "attendanceAllowRs": 0,
  "da": 0,
  "daper": 0,
