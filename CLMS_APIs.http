PUT {{CLMS_APIs_HostAddress}}/api/holidays/1
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "holidayDate": "2026-10-02T00:00:00Z",
  "holidayDesc": "Mahatma Gandhi Jayanti (National Holiday)",
